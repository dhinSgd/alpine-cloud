# Alpine Linux 源镜像配置
# 升级版本时只需修改 ALPINE_VERSION / ALPINE_MAJOR_MINOR

ALPINE_VERSION="3.23.4"
ALPINE_MAJOR_MINOR="3.23"

# 镜像基础 URL（CDN）
ALPINE_BASE_URL="https://dl-cdn.alpinelinux.org/alpine/v${ALPINE_MAJOR_MINOR}/releases/cloud"

# UEFI 启动版本
UEFI_IMAGE_FILE="generic_alpine-${ALPINE_VERSION}-x86_64-uefi-cloudinit-r0.qcow2"
UEFI_IMAGE_URL="${ALPINE_BASE_URL}/${UEFI_IMAGE_FILE}"
UEFI_IMAGE_SHA512_URL="${UEFI_IMAGE_URL}.sha512"

# BIOS 启动版本
BIOS_IMAGE_FILE="generic_alpine-${ALPINE_VERSION}-x86_64-bios-cloudinit-r0.qcow2"
BIOS_IMAGE_URL="${ALPINE_BASE_URL}/${BIOS_IMAGE_FILE}"
BIOS_IMAGE_SHA512_URL="${BIOS_IMAGE_URL}.sha512"

# 默认 root 密码（首次登录后必须立即修改）
DEFAULT_ROOT_PASSWORD="slimalpine123"

# 输出镜像虚拟磁盘大小
OUTPUT_DISK_SIZE="1G"

# btrfs 参数（参考 longsays/debian-btrfs）
BTRFS_MOUNT_OPTS="subvol=@,compress-force=zstd:9,discard=async,relatime,max_inline=3796,commit=60,space_cache=v2"
BTRFS_MKFS_OPTS="-f -M -n 4k"
